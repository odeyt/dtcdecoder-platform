# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public browser configuration
# Source: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Supabase server-only credential. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Admin authorization (comma-separated email addresses; server-only)
ADMIN_ALLOWED_EMAILS=thammo01@outlook.com

# Anthropic API key for the AI diagnostic assistant and diagnostic-report
# translation pipeline (see docs/LOCALIZATION_ARCHITECTURE.md). Server-only.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Storage buckets created by the included Supabase migrations
SUPABASE_STORAGE_BUCKET_FILES=product-files
SUPABASE_STORAGE_BUCKET_PREVIEWS=product-previews

# Billing remains disabled until Creem sandbox testing is complete
NEXT_PUBLIC_BILLING_ENABLED=false

# Creem server-only configuration
# Sandbox: https://test-api.creem.io/v1
# Production: https://api.creem.io/v1
CREEM_API_BASE_URL=https://test-api.creem.io/v1
CREEM_API_KEY=your-creem-sandbox-api-key
CREEM_WEBHOOK_SECRET=your-creem-sandbox-webhook-secret
CREEM_SUCCESS_URL=http://localhost:3000/checkout/success
CREEM_GENERIC_PRODUCT_ID=your-creem-sandbox-product-id

# Diagnostic Scan Report Analysis (docs/SCAN_REPORT_ANALYSIS.md). Ships
# fully built but flagged off — flip to "true" to go live once Supabase
# migrations 0012-0014 have been run against the target project.
NEXT_PUBLIC_SCAN_DIAGNOSTICS_ENABLED=false
SUPABASE_STORAGE_BUCKET_SCAN_FILES=diagnostic-scan-files
SCAN_FILE_MAX_SIZE_BYTES=15728640

# --- Multi-model diagnostic orchestrator (docs/MULTI_MODEL_ORCHESTRATOR.md) ---
# Ships fully built but disabled by default. With every flag below at its
# default, scan-report analysis behaves EXACTLY like the pre-orchestrator
# single-Anthropic-provider pipeline — nothing here changes behavior until
# AI_ORCHESTRATOR_ENABLED is explicitly set to "true", and migration 0029
# has been run. See docs/AI_PROVIDER_CONFIGURATION.md for the full
# required/optional/sensitive breakdown of every variable below.

# Master switch — must be "true" for ANY of the rest of this section to
# have any effect at all.
AI_ORCHESTRATOR_ENABLED=false

# OpenAI (configurable primary assessor). Server-only; never required
# unless OPENAI_PRIMARY_ENABLED=true.
OPENAI_API_KEY=your-openai-api-key
OPENAI_PRIMARY_MODEL=
OPENAI_FALLBACK_MODEL=
OPENAI_PRIMARY_ENABLED=false

# Anthropic reviewer — the existing ANTHROPIC_API_KEY above is reused (same
# account, same SDK, already required). Opt-out (default true) rather than
# opt-in: once the orchestrator itself is enabled, an Anthropic review is
# the established safety-net behavior this app already ran exclusively
# before the orchestrator existed.
ANTHROPIC_REVIEW_ENABLED=true

# Gemini — scaffolded, never called while false (the only supported value
# today; no @google/genai dependency is even installed yet). See
# docs/MULTI_MODEL_ORCHESTRATOR.md "Gemini scaffold."
GEMINI_API_KEY=
GEMINI_MULTIMODAL_MODEL=
GEMINI_PROVIDER_ENABLED=false

# Fixed role assignment — not currently swappable via env, documented here
# for parity with the orchestrator spec's own env block.
AI_PRIMARY_PROVIDER=openai
AI_REVIEW_PROVIDER=anthropic
AI_MULTIMODAL_PROVIDER=gemini

# Router thresholds (all optional — sensible defaults are built in; see
# src/lib/ai-diagnostics/orchestrator-config.ts).
AI_REVIEW_CONFIDENCE_THRESHOLD=0.72
AI_HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.45
AI_QUALITY_AUDIT_PERCENT=5
AI_MAX_ESCALATIONS_PER_CASE=1

# Per-request token/retry/timeout limits (all optional — see
# orchestrator-config.ts for built-in defaults).
AI_MAX_PRIMARY_INPUT_TOKENS=12000
AI_MAX_PRIMARY_OUTPUT_TOKENS=4096
AI_MAX_REVIEW_INPUT_TOKENS=8000
AI_MAX_REVIEW_OUTPUT_TOKENS=2048
AI_MAX_REQUESTS_PER_CASE=2
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_MAX_RETRIES=1

# Owner-level aggregate USD budget guard — every value below is OPTIONAL
# and OFF (no ceiling) unless set. A configured value here overrides
# subscription-plan behavior: even a Workshop-plan user is subject to these
# once configured. Per-shop has no distinct entity in this schema and is
# evaluated as an alias of the per-user figure — see
# docs/AI_BUDGET_GUARD.md.
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=
AI_PER_CASE_BUDGET_USD=
AI_PER_USER_DAILY_BUDGET_USD=
AI_PER_SHOP_MONTHLY_BUDGET_USD=

# Soft/hard budget-percent thresholds (of whichever *_BUDGET_USD values
# above are actually configured).
AI_BUDGET_WARNING_PERCENT=75
AI_BUDGET_RESTRICT_PERCENT=90
AI_BUDGET_HARD_STOP_PERCENT=100

# Optional per-model $/million-token overrides for the cost ledger — see
# src/lib/ai-diagnostics/cost.ts. Leave unset to use the built-in estimates
# (marked as estimates, never presented as verified pricing).
OPENAI_INPUT_PER_MILLION_USD=
OPENAI_OUTPUT_PER_MILLION_USD=
ANTHROPIC_INPUT_PER_MILLION_USD=
ANTHROPIC_CACHED_INPUT_PER_MILLION_USD=
ANTHROPIC_OUTPUT_PER_MILLION_USD=
GEMINI_INPUT_PER_MILLION_USD=
GEMINI_OUTPUT_PER_MILLION_USD=
