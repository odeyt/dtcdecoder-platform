# Supabase — create a project at supabase.com, then Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments — Creem.io
# Production API base: https://api.creem.io/v1
# Sandbox/test API base: https://test-api.creem.io/v1
NEXT_PUBLIC_BILLING_ENABLED=false
PAYMENT_PROVIDER=creem
CREEM_API_BASE_URL=https://test-api.creem.io/v1
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_SUCCESS_URL=http://localhost:3000/checkout/success
# A single generic one-time-payment "product" created once in the Creem
# dashboard. Every checkout uses this product_id with custom_price set to
# the specific item's price, so you don't need to create a Creem product
# per wiring diagram / software listing.
CREEM_GENERIC_PRODUCT_ID=

# Admin — comma-separated list of emails allowed into /admin
ADMIN_ALLOWED_EMAILS=thammo01@outlook.com

# Storage bucket names (defaults shown; only set to override)
SUPABASE_STORAGE_BUCKET_FILES=product-files
SUPABASE_STORAGE_BUCKET_PREVIEWS=product-previews
