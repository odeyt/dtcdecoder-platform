# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public browser configuration
# Source: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Supabase server-only credential. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Admin authorization (comma-separated email addresses; server-only)
ADMIN_ALLOWED_EMAILS=thammo01@outlook.com

# Storage buckets created by the included Supabase migrations
SUPABASE_STORAGE_BUCKET_FILES=product-files
SUPABASE_STORAGE_BUCKET_PREVIEWS=product-previews

# Billing remains disabled until Creem sandbox testing is complete
NEXT_PUBLIC_BILLING_ENABLED=false

# Creem server-only configuration
# Sandbox: https://test-api.creem.io/v1
# Production: https://api.creem.io/v1
CREEM_API_BASE_URL=https://test-api.creem.io/v1
CREEM_API_KEY=your-creem-sandbox-api-key
CREEM_WEBHOOK_SECRET=your-creem-sandbox-webhook-secret
# Where Creem redirects the browser after a successful checkout — point
# this at /account?checkout=success so the account page's bounded credit
# poll (CreditGrantPoller) can pick up the webhook-granted credit.
CREEM_SUCCESS_URL=http://localhost:3000/account?checkout=success
CREEM_GENERIC_PRODUCT_ID=your-creem-sandbox-product-id

# Professional Diagnostic Report — one-time $6.99 introductory purchase
# (src/lib/pricing.ts PROFESSIONAL_REPORT_ONE_TIME). Checkout for this
# product stays disabled until this is set to a real Creem product id
# configured with the introductory price.
CREEM_PROFESSIONAL_REPORT_PRODUCT_ID=your-creem-sandbox-product-id

# Diagnostic Scan Report Analysis (docs/SCAN_REPORT_ANALYSIS.md). Ships
# fully built but flagged off — flip to "true" to go live once Supabase
# migrations 0012-0014 have been run against the target project.
NEXT_PUBLIC_SCAN_DIAGNOSTICS_ENABLED=false
SUPABASE_STORAGE_BUCKET_SCAN_FILES=diagnostic-scan-files
SCAN_FILE_MAX_SIZE_BYTES=15728640

# Photo/screenshot upload (Android/iPhone camera photos of a scan-tool
# screen) — requires migration 0046. All optional; shown at their defaults.
SCAN_IMAGE_MAX_SIZE_BYTES=10485760
SCAN_IMAGE_MAX_COUNT=10
SCAN_IMAGE_MAX_TOTAL_SIZE_BYTES=41943040
SCAN_IMAGE_MAX_PIXEL_DIMENSION=8000
SCAN_IMAGE_DOWNSCALE_MAX_DIMENSION=2400

# --- Multi-model diagnostic orchestrator (docs/MULTI_MODEL_ORCHESTRATOR.md) ---
# Ships fully built but disabled by default. With every flag below at its
# default, scan-report analysis behaves EXACTLY like the pre-orchestrator
# single-Anthropic-provider pipeline — nothing here changes behavior until
# AI_ORCHESTRATOR_ENABLED is explicitly set to "true", and migration 0029
# has been run. See docs/AI_PROVIDER_CONFIGURATION.md for the full
# required/optional/sensitive breakdown of every variable below.

# Master switch — must be "true" for ANY of the rest of this section to
# have any effect at all.
AI_ORCHESTRATOR_ENABLED=false

# OpenAI — the sole AI provider for every feature in this app (diagnostic
# assistant chat, scan-report diagnosis/vision extraction, Diagnostic
# Engine, and all translation). Server-only, required.
#
# OPENAI_PRIMARY_MODEL: the strong-reasoning tier — diagnosis, vision
# extraction (reading a scan-tool photo), and the Diagnostic Engine's turn
# reasoning all use this model. OPENAI_FALLBACK_MODEL: retried once, only
# for a transient/server-side failure of the primary model (see
# src/lib/scan-diagnostics/ai/openai-provider.ts). OPENAI_TRANSLATION_MODEL:
# the economical tier — every translation call site (chat-answer
# translation, DTC/scan-report/Diagnostic-Engine-turn translation) uses
# this instead, since translating already-generated text needs less
# reasoning than producing it. Fill in real OpenAI model ids for all
# three — none is hardcoded in this codebase.
OPENAI_API_KEY=your-openai-api-key
OPENAI_PRIMARY_MODEL=
OPENAI_FALLBACK_MODEL=
OPENAI_TRANSLATION_MODEL=
# Only relevant to the dormant multi-model orchestrator (AI_ORCHESTRATOR_
# ENABLED, off by default, below) — every live call site in this app
# constructs OpenAiDiagnosticProvider directly regardless of this flag.
OPENAI_PRIMARY_ENABLED=false

# Gemini — scaffolded, never called while false (the only supported value
# today; no @google/genai dependency is even installed yet). See
# docs/MULTI_MODEL_ORCHESTRATOR.md "Gemini scaffold."
GEMINI_API_KEY=
GEMINI_MULTIMODAL_MODEL=
GEMINI_PROVIDER_ENABLED=false

# Fixed role assignment — not currently swappable via env, documented here
# for parity with the orchestrator spec's own env block. No reviewer is
# implemented today (the only provider that ever filled this role was
# Anthropic, retired) — getReviewerProvider() always returns null
# regardless of this value; see src/lib/scan-diagnostics/ai/registry.ts.
AI_PRIMARY_PROVIDER=openai
AI_REVIEW_PROVIDER=none
AI_MULTIMODAL_PROVIDER=gemini

# Router thresholds (all optional — sensible defaults are built in; see
# src/lib/ai-diagnostics/orchestrator-config.ts).
AI_REVIEW_CONFIDENCE_THRESHOLD=0.72
AI_HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.45
AI_QUALITY_AUDIT_PERCENT=5
AI_MAX_ESCALATIONS_PER_CASE=1

# Per-request token/retry/timeout limits (all optional — see
# orchestrator-config.ts for built-in defaults).
AI_MAX_PRIMARY_INPUT_TOKENS=12000
AI_MAX_PRIMARY_OUTPUT_TOKENS=4096
AI_MAX_REVIEW_INPUT_TOKENS=8000
AI_MAX_REVIEW_OUTPUT_TOKENS=2048
AI_MAX_REQUESTS_PER_CASE=2
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_MAX_RETRIES=1

# Owner-level aggregate USD budget guard — every value below is OPTIONAL
# and OFF (no ceiling) unless set. A configured value here overrides
# subscription-plan behavior: even a Workshop-plan user is subject to these
# once configured. Per-shop has no distinct entity in this schema and is
# evaluated as an alias of the per-user figure — see
# docs/AI_BUDGET_GUARD.md.
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=
AI_PER_CASE_BUDGET_USD=
AI_PER_USER_DAILY_BUDGET_USD=
AI_PER_SHOP_MONTHLY_BUDGET_USD=

# Soft/hard budget-percent thresholds (of whichever *_BUDGET_USD values
# above are actually configured).
AI_BUDGET_WARNING_PERCENT=75
AI_BUDGET_RESTRICT_PERCENT=90
AI_BUDGET_HARD_STOP_PERCENT=100

# Optional per-model $/million-token overrides for the cost ledger — see
# src/lib/ai-diagnostics/cost.ts. Leave unset to use the built-in estimates
# (marked as estimates, never presented as verified pricing).
OPENAI_INPUT_PER_MILLION_USD=
OPENAI_OUTPUT_PER_MILLION_USD=
GEMINI_INPUT_PER_MILLION_USD=
GEMINI_OUTPUT_PER_MILLION_USD=

# --- Phase 2 diagnostic engine (docs/PHASE_2_ARCHITECTURE.md) ---
# Ships fully built but disabled by default. Each flag gates one engine
# component independently; none of them affect Phase 1 behavior (Scan
# Report Analysis, DTC Technician chat, the landing intake) since those
# call the existing, unchanged pipelines.
DIAGNOSTIC_GRAPH_ENABLED=false
QUESTION_ENGINE_ENABLED=false
PROBABILITY_ENGINE_ENABLED=false
CONFIDENCE_ENGINE_ENABLED=false
REPAIR_VERIFICATION_ENABLED=false
TEST_PLANNER_ENABLED=false

# Phase 2.1 staged rollout — master gate for /api/diagnostic-engine/v1/*,
# checked on top of the per-module flags above. One of: disabled (default),
# internal_only, allowlist_only, all_paid_users. See docs/PHASE_2_1_RELEASE_PLAN.md.
DIAGNOSTIC_ENGINE_ROLLOUT_TIER=disabled
# Comma-separated emails granted internal-tester access under allowlist_only
# (separate from ADMIN_ALLOWED_EMAILS — a tester need not be an admin).
DIAGNOSTIC_ENGINE_ALLOWED_EMAILS=

# Phase 2.2 aggregate cost/budget guardrails (docs/PHASE_2_2_COST_GUARDRAILS.md).
# All unset by default = unlimited on that dimension — set only what you
# actually want to cap. Checked before every provider call, on top of the
# existing per-request cost ceiling.
DIAGNOSTIC_ENGINE_DAILY_BUDGET_USD=
DIAGNOSTIC_ENGINE_MONTHLY_BUDGET_USD=
DIAGNOSTIC_ENGINE_USER_DAILY_BUDGET_USD=
DIAGNOSTIC_ENGINE_USER_MONTHLY_BUDGET_USD=
DIAGNOSTIC_ENGINE_INTERNAL_DAILY_BUDGET_USD=
# Emergency stop — set to "true" to block every Diagnostic Engine provider
# call immediately, regardless of remaining budget on any dimension.
DIAGNOSTIC_ENGINE_PROVIDER_KILL_SWITCH=false

# Push notifications (Capacitor Android shell — docs/CAPACITOR_ANDROID_SETUP.md).
# Full JSON contents of a Firebase service account key (Console -> Project
# Settings -> Service Accounts -> Generate new private key), as a single
# line. Unset by default: the feature no-ops until a real Firebase project
# exists, rather than crashing. android/app/google-services.json is the
# separate client-side config file (safe to commit, lives in android/app/,
# not in this env file).
FIREBASE_SERVICE_ACCOUNT_JSON=
